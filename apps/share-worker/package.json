{
  "name": "@chatto/share-worker",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "Chatto's theme sharing service: a Cloudflare Worker with D1 and R2",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler d1 migrations apply chatto-share --remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply chatto-share --local",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@chatto/chat-ui": "0.1.0",
    "@chatto/core": "0.1.0",
    "@chatto/share": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "wrangler": "^4.157.0"
  }
}
