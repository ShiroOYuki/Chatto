{
  "name": "chatto",
  "version": "0.1.1",
  "private": true,
  "description": "Chatto — Twitch chat overlay and OBS embed chat as a desktop app",
  "license": "GPL-3.0-or-later",
  "author": "Ciel",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @chatto/viewer && npm run dev -w @chatto/desktop",
    "dev:viewer": "npm run dev -w @chatto/viewer",
    "build": "npm run build -w @chatto/viewer && npm run build -w @chatto/desktop",
    "dist": "npm run build && npm run build:obs-plugin && npm run dist -w @chatto/desktop",
    "build:obs-plugin": "node scripts/build-obs-plugin.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=web",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:electron": "npm run build && playwright test --project=electron",
    "test:all": "npm run typecheck && npm test && npm run test:e2e && npm run test:visual && npm run test:electron",
    "format": "prettier --write .",
    "dev:web": "npm run dev:web -w @chatto/desktop"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
